{
    "$schema": "https://json.schemastore.org/web-manifest.json",
    "name": "Jeleboo — Malaysia Air Quality",
    "short_name": "Jeleboo",
    "description": "Live air quality and haze readings for Malaysia, with notifications when your threshold is crossed.",
    "lang": "en-MY",
    "dir": "ltr",
    "id": "jeleboo",
    "scope": "/",
    "start_url": "/",
    "orientation": "portrait",
    "display": "standalone",
    "display_override": ["fullscreen", "minimal-ui", "window-controls-overlay"],
    "theme_color": "#FAFAF7",
    "background_color": "#FAFAF7",
    "categories": ["weather", "health", "utilities"],
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "any"
        }
    ]
}