// Jeleboo — local environment variables. NEVER commit this file.
// Copy real values from your provider accounts; placeholders here are intentional.

# Backend
PORT=3000
WAQI_TOKEN=your-waqi-token-here
DATABASE_PATH=./jeleboo.sqlite

# Web Push (VAPID) — generate once with web-push and paste here.
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPIDmailto=mailto:your-email@example.com